      "700": { "$value": "oklch(0.373 0.016 264.364)", "$type": "color" },
      "800": { "$value": "oklch(0.269 0.012 264.364)", "$type": "color" },
      "900": { "$value": "oklch(0.205 0.008 264.364)", "$type": "color" },
      "950": { "$value": "oklch(0.145 0.005 264.364)", "$type": "color" }
